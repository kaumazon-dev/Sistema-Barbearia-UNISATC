POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DB_NAME
DATABASE_URL=postgresql://usuario:senha@db:5432/db_name
APP_ENV=dev
SECRET_KEY=6d1099c802f52d478a5b64864a1632a68dd592311090175a3d89672c78573d00
JWT_SECRET_KEY=16f5f655d1a4984fccfa42fa09a34268e3f975dad38a70ecbe9697e05dee9476
DATABASE_URL_TEST=postgresql://usuario:senha@db:5432/db_name_test

# Origens permitidas pelo CORS, separadas por virgula (nunca usar *)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Minutos de validade do token JWT (padrao 60 se ausente ou invalido)
JWT_EXPIRA_MINUTOS=720

# Esqueci minha senha
# Endereco do front usado no link do e-mail (em prod, padrao = 1a origem do CORS)
FRONTEND_URL=http://localhost:5173
# Minutos de validade do link (padrao 30)
REDEFINIR_SENHA_EXPIRA_MINUTOS=30
# SMTP. Deixe MAIL_SERVIDOR vazio para so escrever o e-mail no log do Flask.
# Gmail: smtp.gmail.com, porta 587, usuario = seu e-mail, senha = "senha de app".
MAIL_SERVIDOR=
MAIL_PORTA=587
MAIL_USUARIO=
MAIL_SENHA=
MAIL_REMETENTE=
MAIL_USAR_TLS=true

# Limite de tentativas (login, cadastro, esqueci/redefinir senha)
# Quantos proxies ficam na frente da API: 1 no compose (nginx), 0 sem proxy.
PROXIES_CONFIAVEIS=1
# Contadores em memoria por padrao; para varios processos dividirem a conta:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
# Desligar o limite (nao recomendado): RATELIMIT_ATIVO=false
