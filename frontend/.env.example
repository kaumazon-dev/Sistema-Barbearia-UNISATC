# URL completa da API, usada so no build de producao (Vercel).
# Vazio = mesma origem (/api/v1), que e o caso do Vite em dev e do nginx no compose.
# No Vercel: Settings > Environment Variables > VITE_API_URL.
# O backend precisa ter a URL do front em CORS_ORIGINS, senao o navegador bloqueia.
VITE_API_URL=https://barbearia-api.onrender.com/api/v1
